font_family JetBrainsMono Nerd Font Mono Regular
bold_font JetBrainsMono Nerd Font Mono Bold
italic_font JetBrainsMono Nerd Font Mono Italic
bold_italic_font JetBrainsMono Nerd Font Mono Bold Italic

font_size 11.5
adjust_line_height 120%

cursor_blink_interval 0
enable_audio_bell 0
window_padding_width 8
background_opacity 1


# BEGIN_KITTY_THEME
include ./theme.conf
# END_KITTY_THEME

# OPEN TABS AND WINDOWS IN CURRENT DIR
map ctrl+t new_tab_with_cwd
map ctrl+enter new_window_with_cwd

macos_option_as_alt yes

# neovim integration - skipped for now due to keymaps conflicts
allow_remote_control yes
listen_on unix:/tmp/mykitty

#map ctrl+j kitten pass_keys.py bottom ctrl+j "^.* - nvim$"
#map ctrl+k kitten pass_keys.py top    ctrl+k "^.* - nvim$"
#map ctrl+h kitten pass_keys.py left   ctrl+h "^.* - nvim$"
#map ctrl+l kitten pass_keys.py right  ctrl+l "^.* - nvim$"



# search using fzf
#map ctrl+f launch --type=overlay --stdin-source=@screen_scrollback /opt/homebrew/bin/fzf --no-sort --no-mouse --exact -i --tac
map ctrl+f launch --type=overlay --stdin-source=@screen_scrollback nvim -c 'set nobackup nowritebackup' -c 'set buftype=nofile' -c 'normal G'
